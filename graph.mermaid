---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	language_input_node(language_input_node)
	router_node(router_node)
	product_info_node(product_info_node)
	requirement_node(requirement_node)
	recommendation_node(recommendation_node)
	general_node(general_node)
	language_output_node(language_output_node)
	__end__([<p>__end__</p>]):::last
	__start__ --> language_input_node;
	general_node --> language_output_node;
	language_input_node --> router_node;
	product_info_node --> language_output_node;
	recommendation_node --> language_output_node;
	requirement_node --> language_output_node;
	router_node -.-> general_node;
	router_node -.-> product_info_node;
	router_node -.-> recommendation_node;
	router_node -.-> requirement_node;
	language_output_node --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
